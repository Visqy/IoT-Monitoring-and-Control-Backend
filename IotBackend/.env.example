# Copy file ini jadi ".env" (di folder IotBackend/, sejajar dengan IotBackend.csproj)
# lalu isi nilai asli. ".env" sudah di-gitignore — JANGAN commit file itu ke Git.
# Pemisah section pakai "__" (double underscore), bukan ":" — itu konvensi environment
# variable provider bawaan ASP.NET Core.

# --- HiveMQ Cloud ---
Mqtt__Host=GANTI_DENGAN_HOST_HIVEMQ
Mqtt__Port=8883
Mqtt__Username=GANTI_DENGAN_USERNAME_HIVEMQ
Mqtt__Password=GANTI_DENGAN_PASSWORD_HIVEMQ
Mqtt__ClientId=iot-backend-poc
Mqtt__TelemetryTopic=+/pzem
Mqtt__StatusTopic=+/status
Mqtt__RelayStateTopic=+/relay/state

# --- PostgreSQL: pilih SALAH SATU baris ConnectionStrings__Postgres di bawah ---

# Opsi A - PostgreSQL lokal
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=iot_monitoring;Username=iot_user;Password=GANTI_PASSWORD_POSTGRES;SSL Mode=Disable

# Opsi B - Supabase (hapus baris Opsi A di atas, aktifkan baris ini, isi nilainya)
# ConnectionStrings__Postgres=Host=GANTI_HOST_SUPABASE;Port=5432;Database=postgres;Username=GANTI_USERNAME_SUPABASE;Password=GANTI_PASSWORD_SUPABASE;SSL Mode=Require
